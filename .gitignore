# Root .gitignore for NexusPulse Full-Stack Workspace

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build outputs
dist/
dist-ssr/
frontend/dist/
*.local

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep
